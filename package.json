{
  "name": "dsh-startup-screen-exile",
  "version": "1.3.0-exile.5",
  "description": "EXILE startup screen for DeepSeek Harness: black curtain with the EXILE mark, over-exposed wash, warm paper plate, five-step interactive access sequence. Green binary-rain background (CRT scanlines, trails).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "startup",
    "splash",
    "exile",
    "binary-rain"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "preview/index.html",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "DESKTOP.md",
    "AUDIO-FIELDS.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "exile412 (modification) / 沈宏宏 (original)"
}
