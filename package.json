{
  "name": "dsh-startup-screen-exile",
  "version": "1.3.0-exile.1",
  "description": "EXILE 版启动界面：黑幕 EXILE 标识 → 过曝 → 青色档案底板 → 交互授权序列。第一幕：不止AI，步入生活，改变生活 / MORE THAN AI. STEP INTO LIFE. CHANGE LIVES.；第二幕左上角：AI不止于现在更能改变未来。背景为绿色二进制数字雨（纵向为主、后段横向穿插）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "startup",
    "splash",
    "exile",
    "binary-rain"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "docs",
    "preview/index.html",
    "open-preview.sh",
    "打开预览.cmd",
    "安装.cmd",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "DESKTOP.md",
    "AUDIO-FIELDS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke-host.mjs && node test/smoke-splash.mjs && node test/smoke-client.mjs && node test/smoke-desktop-boot.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6shenhonghong9/dsh-startup-screen.git"
  },
  "bugs": {
    "url": "https://github.com/6shenhonghong9/dsh-startup-screen/issues"
  },
  "homepage": "https://github.com/6shenhonghong9/dsh-startup-screen#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "沈宏宏"
}
